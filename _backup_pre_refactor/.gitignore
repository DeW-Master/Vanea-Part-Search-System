# ============================================
# .gitignore - Git 忽略文件
# ============================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
pip-log.txt
pip-delete-this-directory.txt

# ---------- 虚拟环境 ----------
venv/
env/
ENV/
.venv/
virtualenv/
.python-version

# ---------- 测试 & 覆盖率 ----------
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.tox/

# ---------- Jupyter Notebook ----------
.ipynb_checkpoints

# ---------- Flask ----------
instance/
.webassets-cache

# ---------- 数据库 & 数据 ----------
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/cloud_config.json
data/uploads/
*.db
*.sqlite
*.sqlite3

# ---------- 备份 ----------
backup/
*.bak
*.backup

# ---------- 日志 ----------
logs/
*.log

# ---------- 环境变量 ----------
.env
.env.local
.env.*.local

# ---------- 编辑器/IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
*.sublime-workspace
*.sublime-project

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------- 临时文件 ----------
*.tmp
*.temp
*.swp
*.swo

# ---------- 部署相关 ----------
deploy/
nginx/

# ---------- 其他 ----------
*.pid
*.seed
*.pid.lock
node_modules/
