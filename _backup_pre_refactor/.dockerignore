# ============================================
# .dockerignore - Docker 构建忽略文件
# ============================================

# ---------- Python 缓存 ----------
__pycache__/
*.pyc
*.pyo
*.pyd
*.py,cover
.pytest_cache/
.coverage
htmlcov/

# ---------- Git ----------
.git/
.gitignore
.gitattributes

# ---------- 编辑器/IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- 运维脚本（不需要打进镜像） ----------
scripts/
*.bat

# ---------- 文档 ----------
*.md

# ---------- 数据目录（通过 volume 挂载，不要打进镜像） ----------
data/

# ---------- 备份目录 ----------
backup/

# ---------- Nginx 配置（单独挂载，不打进镜像） ----------
nginx/

# ---------- 环境变量 ----------
.env
.env.local

# ---------- 日志 ----------
*.log
logs/

# ---------- 测试 ----------
tests/
test_*.py

# ---------- 系统文件 ----------
.DS_Store
Thumbs.db

# ---------- 临时文件 ----------
*.tmp
*.bak
