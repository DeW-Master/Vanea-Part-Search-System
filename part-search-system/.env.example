# ============================================
# van.ea 车辆零件智能查询系统 - 环境变量配置示例
# 版本: v2.0.0 (Phase 3)
# ============================================
# 复制此文件为 .env 并修改对应值
# 注意: .env 文件包含敏感信息，切勿提交到版本控制！
# ============================================

# ==========================================================================
# 1. 基础配置 (必须修改)
# ==========================================================================
ADMIN_PASSWORD=admin2026
SECRET_KEY=parts-search-secret-key-2026-change-me-to-random

# ==========================================================================
# 2. Flask 服务配置
# ==========================================================================
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ==========================================================================
# 3. 数据库配置 (双引擎: SQLite 默认, PostgreSQL 可选)
# ==========================================================================
# 3.1 SQLite (默认, 单副本/中小数据量)
DB_TYPE=sqlite
PARTS_DB_PATH=/app/data/parts.db

# 3.2 PostgreSQL (大数据量/多副本生产推荐)
# 启用方法: 改为 DB_TYPE=postgresql, 并启动时加 --profile postgres
# DB_TYPE=postgresql
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_USER=van_ea
# POSTGRES_PASSWORD=van_ea_2026
# POSTGRES_DB=van_ea_parts
# POSTGRES_SSLMODE=prefer

# ==========================================================================
# 4. 文件上传
# ==========================================================================
PARTS_UPLOAD_DIR=/app/data/uploads

# ==========================================================================
# 4.1 CORS (跨域, 默认同源部署无需配置)
# 仅当前端与 API 分属不同域名时配置, 逗号分隔:
# CORS_ORIGINS=https://parts.example.com,https://parts2.example.com
CORS_ORIGINS=

# ==========================================================================
# 5. Redis (缓存 + Session + Leader Election)
# ==========================================================================
REDIS_URL=redis://redis:6379/0
CACHE_ENABLED=true
CACHE_TTL=300
CACHE_KEY_PREFIX=fbrain

# ==========================================================================
# 6. Session 存储 (多副本必需选 redis 或 filesystem)
# ==========================================================================
# SESSION_TYPE: redis | filesystem | null (仅内存，单副本仅限)
SESSION_TYPE=redis
SESSION_LIFETIME_SECONDS=86400
SESSION_USE_SIGNER=true
SESSION_KEY_PREFIX=fbrain_session:
# SESSION_FILE_DIR=/app/data/sessions   # SESSION_TYPE=filesystem 时使用

# ==========================================================================
# 7. Ollama / AI 模型 (Phase 3: 多实例负载均衡)
# ==========================================================================
# 7.1 单实例 (兼容旧版)
OLLAMA_URL=http://host.docker.internal:11434

# 7.2 多实例集群 (Phase 3 新功能, 逗号分隔)
# 示例: 多 Ollama 实例实现负载均衡 + 高可用
# OLLAMA_URLS=http://ollama-1:11434,http://ollama-2:11434,http://ollama-3:11434
OLLAMA_URLS=

# 负载均衡策略: round_robin | least_conn | random
OLLAMA_LB_STRATEGY=round_robin
# 健康检查间隔 (秒)
OLLAMA_HEALTHCHECK_INTERVAL=15
# 请求超时 (秒)
OLLAMA_REQUEST_TIMEOUT=120
# 失败多少次摘除节点
OLLAMA_FAILURE_THRESHOLD=3
# 恢复多久后重新加入 (秒)
OLLAMA_RECOVERY_BACKOFF=60

# 默认模型
OLLAMA_MODEL=qwen2.5:7b

# ==========================================================================
# 8. Delta 预计算
# ==========================================================================
# 刷新间隔 (秒), 0=禁用
DELTA_REFRESH_INTERVAL=300
# 启动后首次延迟 (秒)
DELTA_INITIAL_DELAY=10

# ==========================================================================
# 9. Prometheus Metrics (Phase 3)
# ==========================================================================
METRICS_ENABLED=true
METRICS_ENDPOINT=/metrics
# 可选: Basic Auth 保护 /metrics 端点
METRICS_BASIC_AUTH_USER=
METRICS_BASIC_AUTH_PASS=

# ==========================================================================
# 10. 多副本部署 (Phase 3)
# ==========================================================================
# Web 副本数 (Docker Compose / Swarm 生效)
WEB_REPLICAS=1
# 是否启用领导者选举 (多副本下仅 leader 执行 Delta 预计算等后台任务)
LEADER_ELECTION_ENABLED=true
LEADER_LOCK_KEY=fbrain:leader_lock
LEADER_LOCK_TTL=30
# 实例 ID (自动生成, 一般不需要手动设置)
# INSTANCE_ID=van-ea-1

# ==========================================================================
# 11. Grafana (Phase 3)
# ==========================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin2026
GRAFANA_ROOT_URL=http://localhost/grafana/
